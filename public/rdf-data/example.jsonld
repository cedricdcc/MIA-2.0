{
  "@context": {
    "dct": "http://purl.org/dc/terms/",
    "schema": "https://schema.org/",
    "foaf": "http://xmlns.com/foaf/0.1/"
  },
  "@graph": [
    {
      "@id": "https://example.org/dataset/2",
      "@type": "schema:Dataset",
      "dct:title": "Example JSON-LD Dataset",
      "dct:description": "A sample JSON-LD file used for the MIA 2.0 demo.",
      "schema:url": { "@id": "https://example.org/dataset/2" }
    },
    {
      "@id": "https://example.org/person/bob",
      "@type": "foaf:Person",
      "foaf:name": "Bob Example",
      "foaf:mbox": { "@id": "mailto:bob@example.org" }
    }
  ]
}
